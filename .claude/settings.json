{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/sec-scan-file.sh",
            "timeout": 60,
            "statusMessage": "bandit scan (edited file)"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/sec-scan-commit.sh",
            "if": "Bash(git commit*)",
            "timeout": 180,
            "statusMessage": "security gate (bandit + pip-audit)"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ast-grep-commit.sh",
            "if": "Bash(git commit*)",
            "timeout": 60,
            "statusMessage": "structural gate (ast-grep, staged files)"
          }
        ]
      }
    ]
  }
}
